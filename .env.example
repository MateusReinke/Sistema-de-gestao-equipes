# Copie para .env e preencha. Nenhum destes valores deve ir para o repositório.

# ------------------------------------------------------------------- banco
POSTGRES_USER=lumini
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=lumini

# Usado fora do Docker (desenvolvimento local, migrations, seed).
DATABASE_URL=postgres://lumini:troque-esta-senha@localhost:5432/lumini

# ------------------------------------------------------------- aplicação
# Porta publicada pelo Docker Compose no host.
APP_PORT=8080

# URL pública da aplicação. Precisa ser exatamente a mesma registrada como
# origem no provedor de identidade, e https em produção — o cookie de sessão
# só é enviado por conexão segura.
APP_URL=https://central.lumini.com.br

# Duração da sessão em horas. Oito cobre um expediente sem novo login.
SESSION_HOURS=8

# ------------------------------------------------------------------ segredos
# Chave que cifra o client secret do SSO guardado no banco. Obrigatória em
# produção: sem ela o servidor recusa subir. Trocar a chave torna o segredo
# gravado ilegível — a tela avisa e basta redigitá-lo.
#
#   openssl rand -base64 48
APP_SECRET_KEY=

# ---------------------------------------------------------- autenticação
# A central começa com senha local: o administrador cria os acessos e emite
# senhas temporárias pela tela Autenticação. O SSO é configurado por ali
# também — emissor, client id e segredo —, sem redeploy e sem estas variáveis.
#
# As três abaixo apenas SEMEIAM a primeira leitura, numa base nova. Depois
# disso o banco manda, e mexer aqui não muda nada. O SSO nunca começa ligado.
#
#   O redirect a cadastrar no provedor é:  <APP_URL>/api/auth/callback
#
#   Microsoft Entra ID (Azure AD):
#     OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
#   Google Workspace:
#     OIDC_ISSUER=https://accounts.google.com
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid profile email

# Porta dos fundos: reabre a senha local mesmo desligada na tela. Serve para
# quando o provedor de identidade cai e ninguém consegue entrar. Deixe vazio.
ALLOW_LOCAL_LOGIN=
